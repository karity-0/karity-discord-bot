# Official Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional: sync only to this server during development. Blank = global commands.
DISCORD_GUILD_ID=

# scripts/setup_engine.py installs the pinned engine here.
# Local Karity developers may use ../lua-obfuscator instead (must match the pin).
KARITY_ENGINE_PATH=.engine
KARITY_JOBS_PATH=.jobs

MAX_INPUT_BYTES=262144
MAX_OUTPUT_BYTES=8388608
JOB_TIMEOUT_SECONDS=120
JOB_MEMORY_MB=512
MAX_WORKSPACE_BYTES=134217728
MAX_CONCURRENCY=1
MAX_QUEUE_SIZE=4
QUEUE_TIMEOUT_SECONDS=120
DOWNLOAD_TIMEOUT_SECONDS=30
